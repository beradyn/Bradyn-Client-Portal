{
  "expo": {
    "name": "Bradyn",
    "slug": "bradyn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bradyn-mark.png",
    "scheme": "bradyn",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#050608",
      "resizeMode": "contain",
      "image": "./assets/images/bradyn-mark.png"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/bradyn-mark.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
